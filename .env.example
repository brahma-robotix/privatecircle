# ==============================================================================
# PrivateCircle - Supabase Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local' in the project root.
# 2. In your Supabase Dashboard:
#    Go to: Project Settings -> API (or API Keys)
# 3. Fill in your Project URL and Publishable / Anon Key below.
#
# IMPORTANT SECURITY RULES:
# - ONLY use the public 'anon' key or 'publishable' key.
# - DO NOT include your 'service_role' secret key!
# - DO NOT include your database password!
# - DO NOT include your JWT secret!
# - Files named '.env.local' are git-ignored and won't be pushed to GitHub.
# ==============================================================================

# Your Supabase Project URL (e.g. https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Your Supabase Public Anon / Publishable Key (safe for client-side use)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key

# Optional alias (both VITE_SUPABASE_PUBLISHABLE_KEY and VITE_SUPABASE_ANON_KEY are supported)
# VITE_SUPABASE_ANON_KEY=your-supabase-anon-or-publishable-key
